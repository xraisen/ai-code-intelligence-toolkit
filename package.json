{
  "name": "ai-code-intelligence-toolkit",
  "version": "1.0.9",
  "description": "AI code intelligence toolkit with anti-drift task contracts, graph queries, TypeDoc source-link support, and agent-safe install injection.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "ai-code-intel-install": "bin/install.mjs"
  },
  "files": [
    "bin",
    "templates",
    "scripts",
    "docs",
    "README.md",
    "LICENSE",
    "index.js",
    "benchmark.json",
    "PATCH_NOTES_v1.0.6.md",
    "VALIDATION_REPORT.md",
    "PATCH_NOTES_v1.0.7.md",
    "PATCH_NOTES_v1.0.8.md",
    "PATCH_NOTES_v1.0.8_FINAL_DRIFT_HARDENED.md",
    "PATCH_ROLLUP_v1.0.8_CUMULATIVE.md",
    "PATCH_NOTES_v1.0.8_TYPEDOC_ENTRYPOINT_FIX.md"
  ],
  "scripts": {
    "node-check": "node scripts/package-node-check.mjs",
    "smoke": "node scripts/package-node-check.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "agent-contract",
    "ai",
    "ai-agent",
    "ai-changelog",
    "anti-drift",
    "code-intelligence",
    "codex",
    "drift-control",
    "graphrag",
    "ground-truth",
    "preflight",
    "select-string",
    "smart-validation",
    "source-links",
    "symbol-index",
    "token-conservation",
    "typedoc"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xraisen/ai-code-intelligence-toolkit.git"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "typedoc": ">=0.25"
  },
  "peerDependenciesMeta": {
    "typedoc": {
      "optional": true
    }
  }
}
