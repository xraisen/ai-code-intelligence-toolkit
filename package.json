{
  "name": "ai-code-intelligence-toolkit",
  "version": "1.0.6",
  "description": "Codex-compatible AI code intelligence toolkit with local graph, preflight, leak checks, and TypeDoc source-link support.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "ai-code-intel-install": "./bin/install.mjs"
  },
  "files": [
    "bin",
    "templates",
    "scripts",
    "docs",
    "README.md",
    "LICENSE",
    "index.js",
    "benchmark.json",
    "PATCH_NOTES_v1.0.6.md",
    "VALIDATION_REPORT.md"
  ],
  "scripts": {
    "node-check": "node scripts/package-node-check.mjs",
    "smoke": "node scripts/package-node-check.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "ai",
    "codex",
    "graphrag",
    "typedoc",
    "source-links",
    "preflight"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xraisen/ai-code-intelligence-toolkit.git"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "typedoc": ">=0.25"
  },
  "peerDependenciesMeta": {
    "typedoc": {
      "optional": true
    }
  }
}
